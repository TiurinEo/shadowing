WHISPER_MODEL=base

# Vocametrix: https://www.vocametrix.com/api-docs — ключ только на backend
VOCAMETRIX_API_KEY=
# Необязательно:
# VOCAMETRIX_RATE_LIMIT=100          # запросов на окно (лимит ключа: 100 / 15 мин)
# VOCAMETRIX_RATE_WINDOW=900
# MAX_UPLOAD_BYTES=10485760          # максимум размера записи
# ORIGINAL_AUDIO_DIR=/tmp/shadowing-audio   # кэш аудио оригинала (<videoId>.m4a и т.п.)
# ORIGINAL_AUDIO_CACHE_MB=500
# ORIGINAL_AUDIO_MAX_MB=150          # максимум скачиваемого аудио одного видео
# YTDLP_COOKIES=/path/cookies.txt    # если YouTube требует вход
